{
  "name": "shop",
  "version": "1.0.0",
  "private": true,
  "description": "Premium e-commerce storefront + admin panel on Cloudflare Pages, D1 and R2",
  "scripts": {
    "dev": "wrangler pages dev public --d1=DB --r2=MEDIA --port 8788",
    "db:init:local": "wrangler d1 execute shop-db --local --file=./migrations/0001_init.sql",
    "db:seed:local": "wrangler d1 execute shop-db --local --file=./seed.sql",
    "db:init:remote": "wrangler d1 execute shop-db --remote --file=./migrations/0001_init.sql",
    "deploy": "wrangler pages deploy public --project-name=shop"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
